{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "base",
        "model": {
          "type": "minecraft:model",
          "model": "touristry:item/tourist_camera_instamatic"
        }
      },
      {
        "when": "cube",
        "model": {
          "type": "minecraft:model",
          "model": "touristry:item/tourist_camera_instamatic_with_cube"
        }
      },
      {
        "when": "extender",
        "model": {
          "type": "minecraft:model",
          "model": "touristry:item/tourist_camera_instamatic_with_extender"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "touristry:item/tourist_camera_instamatic"
    }
  }
}